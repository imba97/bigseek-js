{
  "name": "bigseek",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@12.11.2",
  "description": "Browser client for bigseek indexes: WebAssembly query engine, CJK bigram tokenizer and optional MiniSearch fallback",
  "author": "imba97",
  "license": "MIT",
  "homepage": "https://github.com/imba97/bigseek-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imba97/bigseek-js.git"
  },
  "bugs": {
    "url": "https://github.com/imba97/bigseek-js/issues"
  },
  "keywords": [
    "search",
    "wasm",
    "cjk",
    "bigram",
    "index",
    "bigseek"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "build": "unbuild",
    "stub": "unbuild --stub",
    "test": "vitest --run",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "typecheck": "tsc --noEmit",
    "release": "bumpp",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "minisearch": "^7.2.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/node": "^26.6.5",
    "bumpp": "^12.3.0",
    "eslint": "^10.12.0",
    "nano-staged": "^1.0.2",
    "simple-git-hooks": "^2.14.0",
    "typescript": "6.0.3",
    "unbuild": "^3.6.1",
    "vitest": "^5.0.4"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm nano-staged"
  },
  "nano-staged": {
    "*.{js,cjs,mjs,ts,cts,mts,json,md,yml,yaml}": "eslint --cache --fix"
  }
}
